# ==========================================================================
# BoumRank — Environment variables template
# ==========================================================================
# Copy this file to .env.local and fill in the values you need.
# All NEXT_PUBLIC_* vars are exposed to the browser.
# Server-only vars (RESEND_API_KEY, NOTION_*) are never shipped to the client.
#
# Every variable below is OPTIONAL. The site builds + runs without any of them,
# with graceful fallbacks (analytics no-op, lead magnet logs to console, etc.)

# --- Notion blog CMS (optional, blog disabled if absent) --------------------
NOTION_API_KEY=
NOTION_BLOG_DATABASE_ID=

# --- Analytics (optional, guarded by Consent Mode v2) -----------------------
# Google Analytics 4 — format: G-XXXXXXXXXX
# Create a property at https://analytics.google.com then grab the Measurement ID
NEXT_PUBLIC_GA_ID=

# Google Tag Manager — format: GTM-XXXXXXX
# Create a container at https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=

# Meta Pixel ID — 15–16 digits, from https://business.facebook.com/events_manager
NEXT_PUBLIC_META_PIXEL_ID=

# --- Email (Resend) — powers /api/contact + /api/lead-magnet ----------------
# Without RESEND_API_KEY, both routes fall back to a dev-mode console log
# (no email is sent, but the form returns success).
#
# Resend API key — https://resend.com/api-keys
# Scope: "Sending only" is sufficient.
RESEND_API_KEY=

# Send-from address. Must be a verified domain on your Resend account.
# Format: "Display Name <email@domain.com>"
RESEND_FROM=BoumRank <notifications@boumrank.com>

# Internal inbox that receives every form submission (contact form +
# lead-magnet notifications). Defaults to support@boumrank.com.
CONTACT_TO_EMAIL=support@boumrank.com

# --- Chatbot (optional, not yet wired in V1) --------------------------------
# Chatbase bot ID — https://www.chatbase.co
NEXT_PUBLIC_CHATBASE_BOT_ID=

# --- Vercel Blob (auto-injected by Vercel when a Blob store is attached) ----
# Used for hosting the Playbook PDF and other large assets.
BLOB_READ_WRITE_TOKEN=
